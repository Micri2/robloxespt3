local dragging = false
local dragStart
local startPos

local function beginDrag(input)
	dragging = true
	dragStart = input.Position
	startPos = frame.Position
end

local function endDrag()
	dragging = false
end

title.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
	or input.UserInputType == Enum.UserInputType.Touch then
		beginDrag(input)
	end
end)

title.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
	or input.UserInputType == Enum.UserInputType.Touch then
		endDrag()
	end
end)

UserInputService.InputChanged:Connect(function(input)

	if dragging and (
		input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch
	) then

		local delta = input.Position - dragStart

		frame.Position = UDim2.new(
			startPos.X.Scale,
			startPos.X.Offset + delta.X,
			startPos.Y.Scale,
			startPos.Y.Offset + delta.Y
		)
	end
end)

local function restoreAccessories()

	for part, old in pairs(hiddenAccessories) do
		if part and part.Parent then
			part.LocalTransparencyModifier = old
		end
	end

	hiddenAccessories = {}
end

local function hideAccessories(character)

	restoreAccessories()

	for _, item in pairs(character:GetChildren()) do
		if item:IsA("Accessory") then

			for _, part in pairs(item:GetDescendants()) do
				if part:IsA("BasePart") then

					hiddenAccessories[part] = part.LocalTransparencyModifier
					part.LocalTransparencyModifier = 1
				end
			end
		end
	end
end

local function findClosestPlayer(input)

	local text = string.lower(input)
	local bestMatch = nil
	local bestScore = math.huge

	for _, plr in pairs(Players:GetPlayers()) do

		if plr ~= player then

			local plrName = string.lower(plr.Name)
			local score = 999

			if plrName == text then
				return plr
			end

			if string.sub(plrName,1,#text) == text then
				score = 0
			elseif string.find(plrName,text,1,true) then
				score = 1
			end

			if score < bestScore then
				bestScore = score
				bestMatch = plr
			end
		end
	end

	return bestMatch
end

local function updateSuggestions()

	local text = string.lower(textbox.Text)

	for _, child in pairs(suggestionFrame:GetChildren()) do
		if not child:IsA("UIListLayout") then
			child:Destroy()
		end
	end

	if text == "" then
		suggestionFrame.Visible = false
		return
	end

	local found = {}

	for _, plr in pairs(Players:GetPlayers()) do

		if plr ~= player then

			if string.find(string.lower(plr.Name), text, 1, true) then
				table.insert(found, plr)
			end
		end
	end

	if #found == 0 then
		suggestionFrame.Visible = false
		return
	end

	table.sort(found,function(a,b)
		return a.Name:lower() < b.Name:lower()
	end)

	for _, plr in pairs(found) do

		local btn = Instance.new("TextButton")
		btn.Size = UDim2.new(1,0,0,28)
		btn.BackgroundColor3 = Color3.fromRGB(50,50,50)
		btn.TextColor3 = Color3.new(1,1,1)
		btn.Text = "  "..plr.Name
		btn.TextXAlignment = Enum.TextXAlignment.Left
		btn.Font = Enum.Font.SourceSans
		btn.TextSize = 18
		btn.Parent = suggestionFrame

		btn.MouseEnter:Connect(function()
			btn.BackgroundColor3 = Color3.fromRGB(70,70,90)
		end)

		btn.MouseLeave:Connect(function()
			btn.BackgroundColor3 = Color3.fromRGB(50,50,50)
		end)

		btn.MouseButton1Click:Connect(function()

			textbox.Text = plr.Name
			suggestionFrame.Visible = false

			textbox:CaptureFocus()
			textbox.CursorPosition = #plr.Name + 1
		end)
	end

	local height = math.min(#found * 30, 120)

	suggestionFrame.Visible = true
	suggestionFrame.Size = UDim2.new(1,-20,0,height)
	suggestionFrame.CanvasSize = UDim2.new(0,0,0,#found * 30)

	toggleButton.Position = UDim2.new(0,10,0,90 + height)
	frame.Size = UDim2.new(0,280,0,145 + height)
end

textbox:GetPropertyChangedSignal("Text"):Connect(updateSuggestions)

textbox.Focused:Connect(function()
	if textbox.Text ~= "" then
		updateSuggestions()
	end
end)

textbox.FocusLost:Connect(function()
	task.wait(0.1)
	suggestionFrame.Visible = false
end)

local function disableCamera()

	enabled = false
	targetPlayer = nil

	restoreAccessories()

	camera.CameraType = Enum.CameraType.Custom
	camera.FieldOfView = 70

	vignette.ImageTransparency = 1

	toggleButton.Text = "Toggle Camera"
	toggleButton.BackgroundColor3 = Color3.fromRGB(70,70,70)
end

local function updateCamera()

	if not enabled then
		return
	end

	if not targetPlayer
	or not targetPlayer.Character
	or not targetPlayer.Character.Parent then

		disableCamera()
		return
	end

	local head = targetPlayer.Character:FindFirstChild("Head")
	local humanoid = targetPlayer.Character:FindFirstChildOfClass("Humanoid")

	if not head or not humanoid then
		disableCamera()
		return
	end

	camera.CameraType = Enum.CameraType.Scriptable

	local offset =
		-head.CFrame.LookVector * 6
		+ Vector3.new(0, 2, 0)

	local camPos = head.Position + offset

	camera.CFrame = CFrame.lookAt(
		camPos,
		head.Position
	)

	camera.FieldOfView = 75

	local hpPercent =
		math.clamp(
			humanoid.Health / math.max(humanoid.MaxHealth,1),
			0,
			1
		)

	vignette.ImageTransparency = hpPercent
end

toggleButton.MouseButton1Click:Connect(function()

	if not enabled then

		local found = Players:FindFirstChild(textbox.Text)

		if not found then
			found = findClosestPlayer(textbox.Text)
		end

		if found
		and found.Character
		and found.Character:FindFirstChild("Head") then

			targetPlayer = found
			enabled = true

			hideAccessories(found.Character)

			textbox.Text = found.Name

			toggleButton.Text = "Disable Camera"
			toggleButton.BackgroundColor3 = Color3.fromRGB(170,70,70)

		else

			toggleButton.Text = "Player not found!"

			task.wait(1)

			if not enabled then
				toggleButton.Text = "Toggle Camera"
			end
		end

	else
		disableCamera()
	end
end)

UserInputService.InputBegan:Connect(function(input,gpe)

	if gpe then
		return
	end

	if UserInputService:GetFocusedTextBox() ~= textbox then
		return
	end

	if input.KeyCode == Enum.KeyCode.Return then

		local closest = findClosestPlayer(textbox.Text)

		if closest then
			textbox.Text = closest.Name
			suggestionFrame.Visible = false
		end
	end
end)

RunService.RenderStepped:Connect(updateCamera)
