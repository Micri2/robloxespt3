local function hideAccessories(character)
    hiddenAccessories = {}
    for _, item in pairs(character:GetChildren()) do
        if item:IsA("Accessory") then
            for _, part in pairs(item:GetDescendants()) do
                if part:IsA("BasePart") then
                    hiddenAccessories[part] = part.LocalTransparencyModifier
                end
            end
        end
    end
end

local function restoreAccessories()
    for part, old in pairs(hiddenAccessories) do
        if part and part.Parent then
            part.LocalTransparencyModifier = old
        end
    end
    hiddenAccessories = {}
end

local function forceHideAccessories()
    for part, _ in pairs(hiddenAccessories) do
        if part and part.Parent then
            part.LocalTransparencyModifier = 1
        end
    end
end

local function findClosestPlayer(input)
    local text = string.lower(input)
    local bestMatch = nil
    local bestScore = math.huge
    
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= player then
            local score = 0
            local plrName = string.lower(plr.Name)
            
            if plrName == text then return plr end
            
            if string.sub(plrName, 1, #text) == text then
                score = 0.1
            elseif string.find(plrName, text, 1, true) then
                score = 0.5
            else
                local minLen = math.min(#text, #plrName)
                for i = 1, minLen do
                    if string.sub(text, i, i) == string.sub(plrName, i, i) then
                        score = score + 1
                    end
                end
                score = (#text - score) / #text
            end
            
            if score < bestScore then
                bestScore = score
                bestMatch = plr
            end
        end
    end
    
    return bestMatch
end

local function updateCamera()
    if not enabled or not targetPlayer or not targetPlayer.Character then
        vignette.ImageTransparency = 1  -- Disable vignette if not spectating
        return
    end

    local head = targetPlayer.Character:FindFirstChild("Head")
    if not head then 
        vignette.ImageTransparency = 1
        return 
    end

    camera.CameraType = Enum.CameraType.Scriptable
    camera.CFrame = head.CFrame * CFrame.new(0, 0, -0.1)
    camera.FieldOfView = 80
    forceHideAccessories()

    local humanoid = targetPlayer.Character:FindFirstChildOfClass("Humanoid")
    if humanoid then
        local hpPercent = humanoid.Health / humanoid.MaxHealth
        vignette.ImageTransparency = hpPercent 
    else
        vignette.ImageTransparency = 1
    end
end

local function updateSuggestions()
    local text = string.lower(textbox.Text)
    if text == "" then
        suggestionFrame.Visible = false
        return
    end

    suggestionFrame:ClearAllChildren()

    local found = {}
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= player and string.find(string.lower(plr.Name), text, 1, true) then
            table.insert(found, plr)
        end
    end

    if #found == 0 then
        suggestionFrame.Visible = false
        return
    end

    table.sort(found, function(a,b) return string.lower(a.Name) < string.lower(b.Name) end)

    for i, plr in ipairs(found) do
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, 0, 0, 28)
        btn.BackgroundColor3 = Color3.fromRGB(50,50,50)
        btn.TextColor3 = Color3.new(1,1,1)
        btn.Text = "  " .. plr.Name
        btn.TextXAlignment = Enum.TextXAlignment.Left
        btn.Font = Enum.Font.SourceSans
        btn.TextSize = 15
        btn.AutoButtonColor = true
        btn.ZIndex = 202
        btn.Parent = suggestionFrame

        btn.MouseButton1Click:Connect(function()
            textbox.Text = plr.Name
            suggestionFrame.Visible = false
            textbox.CursorPosition = #plr.Name + 1
            textbox:CaptureFocus()
        end)

        btn.MouseEnter:Connect(function()
            btn.BackgroundColor3 = Color3.fromRGB(70,70,90)
        end)
        btn.MouseLeave:Connect(function()
            btn.BackgroundColor3 = Color3.fromRGB(50,50,50)
        end)
    end

    local height = math.min(#found * 30, 150)
    suggestionFrame.CanvasSize = UDim2.new(0,0,0, #found * 30)
    suggestionFrame.Size = UDim2.new(1, -20, 0, height)
    suggestionFrame.Visible = true
end

textbox:GetPropertyChangedSignal("Text"):Connect(updateSuggestions)

textbox.Focused:Connect(function()
    if textbox.Text ~= "" then
        updateSuggestions()
    end
end)

textbox.FocusLost:Connect(function(enterPressed)
    suggestionFrame.Visible = false
end)

UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if input.KeyCode == Enum.KeyCode.Return then
        if textbox:IsFocused() then
            local closest = findClosestPlayer(textbox.Text)
            if closest then
                textbox.Text = closest.Name
                suggestionFrame.Visible = false
            end
        end
    end
end)

toggleButton.MouseButton1Click:Connect(function()
    if not enabled then
        local name = textbox.Text
        local found = Players:FindFirstChild(name)
        
        if not found then
            found = findClosestPlayer(name)
        end

        if found and found.Character and found.Character:FindFirstChild("Head") then
            targetPlayer = found
            enabled = true
            hideAccessories(found.Character)
            toggleButton.Text = "Disable Camera"
            toggleButton.BackgroundColor3 = Color3.fromRGB(170,70,70)
            textbox.Text = found.Name
        else
            toggleButton.Text = "Player not found!"
            task.wait(1.2)
            toggleButton.Text = "Toggle Camera"
            toggleButton.BackgroundColor3 = Color3.fromRGB(70,70,70)
        end
    else
        enabled = false
        restoreAccessories()
        targetPlayer = nil
        camera.CameraType = Enum.CameraType.Custom
        camera.FieldOfView  = 70
        vignette.ImageTransparency = 1
        toggleButton.Text = "Toggle Camera"
        toggleButton.BackgroundColor3 = Color3.fromRGB(70,70,70)
    end
end)

